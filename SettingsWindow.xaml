<Window x:Class="SagarIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island Settings"
        Height="540" Width="460"
        WindowStartupLocation="CenterScreen"
        Background="#0A0A0C"
        Foreground="#E6E6E6"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <!-- Standard Button Style with 6px Corner Radius -->
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="Background" Value="#1C1C1E"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill Progress Bar Styled Slider -->
        <Style TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="4" CornerRadius="2,0,0,2" Background="#00E676"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="14" Height="14" CornerRadius="7" Background="#FFFFFF" BorderBrush="#0A0A0C" BorderThickness="1.5">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35" Direction="270"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="4" CornerRadius="0,2,2,0" Background="#26FFFFFF"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <!-- Sleek Minimal Island Badge -->
                <Border Width="28" Height="28" CornerRadius="14" Background="#141416" BorderBrush="#1AFFFFFF" BorderThickness="0.5" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Rectangle Width="14" Height="6" RadiusX="3" RadiusY="3" Fill="#00E676" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Dynamic Island Settings" Foreground="#E6E6E6" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="Customization &amp; Preferences" Foreground="#8E8E93" FontSize="11" FontWeight="Normal"/>
                </StackPanel>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#141416" BorderBrush="#1AFFFFFF" BorderThickness="0.5" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="v1.0.0" Foreground="#555555" FontSize="10" FontWeight="Medium"/>
            </Border>
        </DockPanel>

        <!-- Tabbed Settings Body -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Background="#141416" CornerRadius="6,6,0,0" Margin="0,0,4,0" Padding="12,8">
                                    <ContentPresenter ContentSource="Header" TextBlock.FontSize="11" TextBlock.FontWeight="Normal" TextBlock.Foreground="#8E8E93"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#1C1C1E"/>
                                        <Setter Property="TextBlock.Foreground" Value="#00E676" TargetName="Border"/>
                                        <Setter Property="TextBlock.FontWeight" Value="SemiBold" TargetName="Border"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Features Tab -->
            <TabItem Header="Features">
                <Border Background="#141416" CornerRadius="0,8,8,8" BorderBrush="#14FFFFFF" BorderThickness="0.5" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Active HUD Features" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,12"/>

                            <CheckBox x:Name="ChkVolume" Content="Volume &amp; Mute HUD" Foreground="#E6E6E6" FontSize="12" Margin="0,0,0,12" IsChecked="True"/>
                            <CheckBox x:Name="ChkBrightness" Content="Monitor Brightness HUD" Foreground="#E6E6E6" FontSize="12" Margin="0,0,0,12" IsChecked="True"/>
                            <CheckBox x:Name="ChkBattery" Content="Battery &amp; Charging Status" Foreground="#E6E6E6" FontSize="12" Margin="0,0,0,12" IsChecked="True"/>
                            <CheckBox x:Name="ChkMedia" Content="Media Playback &amp; Now Playing" Foreground="#E6E6E6" FontSize="12" Margin="0,0,0,12" IsChecked="True"/>
                            <CheckBox x:Name="ChkNotifications" Content="Windows Notifications Companion" Foreground="#E6E6E6" FontSize="12" Margin="0,0,0,12" IsChecked="True"/>
                            <CheckBox x:Name="ChkClipboard" Content="Clipboard Changes &amp; Snippets" Foreground="#E6E6E6" FontSize="12" Margin="0,0,0,12" IsChecked="True"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Behavior Tab -->
            <TabItem Header="Behavior">
                <Border Background="#141416" CornerRadius="0,8,8,8" BorderBrush="#14FFFFFF" BorderThickness="0.5" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Interactions &amp; Timing" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <CheckBox x:Name="ChkExpandOnHover" Content="Expand preview on mouse hover" Foreground="#E6E6E6" FontSize="12" Margin="0,0,0,12" IsChecked="True"/>
                        <CheckBox x:Name="ChkExpandOnClick" Content="Expand full card on click" Foreground="#E6E6E6" FontSize="12" Margin="0,0,0,16" IsChecked="True"/>

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Auto-collapse timer (seconds):" Foreground="#8E8E93" FontSize="11" FontWeight="Normal" DockPanel.Dock="Left"/>
                            <TextBlock x:Name="LblAutoCollapse" Text="3.5s" Foreground="#00E676" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <Slider x:Name="SliderAutoCollapse" Minimum="1" Maximum="10" Value="3.5" SmallChange="0.5" LargeChange="1.0" ValueChanged="SliderAutoCollapse_ValueChanged" Margin="0,0,0,16"/>

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Animation Speed (ms):" Foreground="#8E8E93" FontSize="11" FontWeight="Normal" DockPanel.Dock="Left"/>
                            <TextBlock x:Name="LblAnimSpeed" Text="380ms" Foreground="#00E676" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <Slider x:Name="SliderAnimSpeed" Minimum="200" Maximum="800" Value="380" SmallChange="20" LargeChange="50" ValueChanged="SliderAnimSpeed_ValueChanged"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Appearance Tab -->
            <TabItem Header="Appearance">
                <Border Background="#141416" CornerRadius="0,8,8,8" BorderBrush="#14FFFFFF" BorderThickness="0.5" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Pill Sizing &amp; Opacity" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Resting Width (px):" Foreground="#8E8E93" FontSize="11" FontWeight="Normal" DockPanel.Dock="Left"/>
                            <TextBlock x:Name="LblWidth" Text="180px" Foreground="#00E676" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <Slider x:Name="SliderWidth" Minimum="140" Maximum="240" Value="180" ValueChanged="SliderWidth_ValueChanged" Margin="0,0,0,16"/>

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Resting Height (px):" Foreground="#8E8E93" FontSize="11" FontWeight="Normal" DockPanel.Dock="Left"/>
                            <TextBlock x:Name="LblHeight" Text="44px" Foreground="#00E676" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <Slider x:Name="SliderHeight" Minimum="38" Maximum="55" Value="44" ValueChanged="SliderHeight_ValueChanged" Margin="0,0,0,16"/>

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Island Opacity:" Foreground="#8E8E93" FontSize="11" FontWeight="Normal" DockPanel.Dock="Left"/>
                            <TextBlock x:Name="LblOpacity" Text="100%" Foreground="#00E676" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <Slider x:Name="SliderOpacity" Minimum="0.5" Maximum="1.0" Value="1.0" SmallChange="0.05" LargeChange="0.1" ValueChanged="SliderOpacity_ValueChanged"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Startup Tab -->
            <TabItem Header="Startup">
                <Border Background="#141416" CornerRadius="0,8,8,8" BorderBrush="#14FFFFFF" BorderThickness="0.5" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Windows Boot Integration" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <CheckBox x:Name="ChkStartup" Content="Launch Dynamic Island when Windows starts" Foreground="#E6E6E6" FontSize="12" Margin="0,0,0,12"/>
                        <TextBlock Text="Starts the app silently in the background pinned to the top of your primary display." Foreground="#8E8E93" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Footer Actions -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button x:Name="BtnAbout" Content="About" Background="#141416" Foreground="#8E8E93" BorderBrush="#14FFFFFF" BorderThickness="0.5" Padding="16,8" DockPanel.Dock="Left" Click="BtnAbout_Click" Cursor="Hand"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Cancel" Background="#141416" Foreground="#E6E6E6" BorderBrush="#14FFFFFF" BorderThickness="0.5" Padding="16,8" Margin="0,0,8,0" Click="BtnCancel_Click" Cursor="Hand"/>
                <Button x:Name="BtnSave" Content="Save Changes" Background="#00E676" Foreground="#0A0A0C" FontWeight="Bold" BorderThickness="0" Padding="20,8" Click="BtnSave_Click" Cursor="Hand"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
