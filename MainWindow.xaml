<Window x:Class="SagarIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SagarIsland"
        mc:Ignorable="d"
        Title="SagarIsland"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False"
        WindowStartupLocation="Manual"
        Height="240" Width="480"
        Loaded="Window_Loaded"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Window.Resources>
        <!-- Reusable Crisp Vector Path Geometries -->
        <Geometry x:Key="SpeakerHighIcon">M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z</Geometry>
        <Geometry x:Key="SpeakerMuteIcon">M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27l4.73 4.73H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z</Geometry>
        <Geometry x:Key="SunIcon">M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 00-1.41 0 .996.996 0 000 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 00-1.41 0 .996.996 0 000 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96a.996.996 0 000-1.41.996.996 0 00-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36a.996.996 0 000-1.41.996.996 0 00-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z</Geometry>
        <Geometry x:Key="BatteryIcon">M17 5v1.5H19c.55 0 1 .45 1 1v9c0 .55-.45 1-1 1h-2V19c0 .55-.45 1-1 1H4c-.55 0-1-.45-1-1V5c0-.55.45-1 1-1h12c.55 0 1 .45 1 1zm-2 1h-10v12h10V6z</Geometry>
        <Geometry x:Key="PlayIcon">M8 5v14l11-7z</Geometry>
        <Geometry x:Key="PauseIcon">M6 19h4V5H6v14zm8-14v14h4V5h-4z</Geometry>
        <Geometry x:Key="PrevIcon">M6 6h2v12H6zm3.5 6l8.5 6V6z</Geometry>
        <Geometry x:Key="NextIcon">M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z</Geometry>
        <Geometry x:Key="Replay10Icon">M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6 0 2.97-2.16 5.43-5 5.91v2.02c3.95-.49 7-3.85 7-7.93 0-4.42-3.58-8-8-8zm-2 9h-1v-4h1v4zm4-3.5c0-.83-.67-1.5-1.5-1.5S11 10.67 11 11.5v3c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-3zm-1 3.5h-1v-4h1v4z</Geometry>
        <Geometry x:Key="Forward10Icon">M12 5V1l5 5-5 5V7c-3.31 0-6 2.69-6 6 0 2.97 2.16 5.43 5 5.91v2.02c-3.95-.49-7-3.85-7-7.93 0-4.42 3.58-8 8-8zm-2 9h-1v-4h1v4zm4-3.5c0-.83-.67-1.5-1.5-1.5S11 10.67 11 11.5v3c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-3zm-1 3.5h-1v-4h1v4z</Geometry>
        <Geometry x:Key="CheckmarkIcon">M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</Geometry>
        <Geometry x:Key="LinkIcon">M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z</Geometry>
        <Geometry x:Key="FolderIcon">M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z</Geometry>
        <Geometry x:Key="ImageIcon">M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z</Geometry>
        <Geometry x:Key="BellIcon">M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z</Geometry>
        <Geometry x:Key="SettingsIcon">M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z</Geometry>
    </Window.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top">

        <!-- 0. Top Edge Invisible Wake-up Hover Zone (Captures cursor at top bezel) -->
        <Border x:Name="TopEdgeHoverTrigger"
                Height="16"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                MouseEnter="TopEdgeHoverTrigger_MouseEnter"
                IsHitTestVisible="True"
                Panel.ZIndex="99"/>

        <!-- 1. Decoupled Outer Shadow Layer (Subtle / High Quality) -->
        <Border x:Name="IslandShadowLayer"
                Width="180" Height="44"
                Margin="0,4,0,0"
                Background="#000000"
                CornerRadius="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ShadowTranslate" X="0" Y="0"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16"
                                  Color="#000000"
                                  Opacity="0.50"
                                  ShadowDepth="3"
                                  Direction="270"
                                  RenderingBias="Quality" />
            </Border.Effect>
        </Border>

        <!-- 2. Crisp Vector Content Layer (Never Rasterized by DropShadow) -->
        <Border x:Name="IslandPill"
                Width="180" Height="44"
                Margin="0,4,0,0"
                Background="#0A0A0C"
                CornerRadius="22"
                BorderBrush="#1AFFFFFF"
                BorderThickness="0.5"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Cursor="Hand"
                ClipToBounds="True"
                MouseLeftButtonUp="IslandPill_MouseLeftButtonUp"
                MouseEnter="IslandPill_MouseEnter"
                MouseLeave="IslandPill_MouseLeave"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PillTranslate" X="0" Y="0"/>
            </Border.RenderTransform>

            <!-- Subtle Apple Top Gloss Gradient -->
            <Grid x:Name="IslandContent" Margin="12,8,12,8">

                <!-- Collapsed Rest State: Dynamic Ambient Live Glance -->
                <Grid x:Name="CollapsedView" Visibility="Visible" Opacity="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Indicator: Live Breathing Dot or Mini Note -->
                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="4,0,8,0">
                        <!-- Idle Dot -->
                        <Ellipse x:Name="IdleDotIndicator" Width="8" Height="8" Fill="#00E676"/>
                        <!-- Music Note Mini (when playing) -->
                        <Path x:Name="IdleMusicNote" Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                              Fill="#0A84FF" Width="12" Height="12" Stretch="Uniform" Visibility="Collapsed"/>
                    </Grid>

                    <!-- Center Glance: Clock or Title -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="CollapsedCenterText" Text="Sagar Island" Foreground="#E6E6E6" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Right Indicator: Live Clock / Audio Visualizer Bars -->
                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="8,0,4,0">
                        <!-- Live Time Glance (when idle) -->
                        <TextBlock x:Name="CollapsedTimeText" Text="10:45" Foreground="#E6E6E6" FontSize="13" FontWeight="Bold" Visibility="Visible"/>

                        <!-- 4-Bar Equalizer Visualizer (when media playing) -->
                        <StackPanel x:Name="CollapsedVisualizer" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border x:Name="MiniEQ1" Width="2.5" Height="10" CornerRadius="1.2" Background="#00E676" Margin="1,0"/>
                            <Border x:Name="MiniEQ2" Width="2.5" Height="6" CornerRadius="1.2" Background="#00E676" Margin="1,0"/>
                            <Border x:Name="MiniEQ3" Width="2.5" Height="12" CornerRadius="1.2" Background="#00E676" Margin="1,0"/>
                            <Border x:Name="MiniEQ4" Width="2.5" Height="8" CornerRadius="1.2" Background="#00E676" Margin="1,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Volume HUD View -->
                <Grid x:Name="VolumeHUDView" Visibility="Collapsed" Opacity="0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="4,0,4,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Path x:Name="VolumeIconPath" Data="{StaticResource SpeakerHighIcon}" Fill="#0A84FF" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Volume" Foreground="#E6E6E6" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="VolumePercentText" Text="72%" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Volume Progress Capsule Bar -->
                    <Grid Grid.Row="1" Margin="4,0,4,4">
                        <Border Height="4" CornerRadius="2" Background="#26FFFFFF"/>
                        <ProgressBar x:Name="VolumeProgressBar" Height="4" Minimum="0" Maximum="100" Value="72"
                                     Foreground="#0A84FF" Background="Transparent" BorderThickness="0" ClipToBounds="True">
                            <ProgressBar.Resources>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Grid>
                                                    <Border Name="PART_Track" CornerRadius="2" Background="#26FFFFFF"/>
                                                    <Border Name="PART_Indicator" CornerRadius="2" Background="#0A84FF" HorizontalAlignment="Left"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ProgressBar.Resources>
                        </ProgressBar>
                    </Grid>
                </Grid>

                <!-- Mute HUD View -->
                <Grid x:Name="MuteHUDView" Visibility="Collapsed" Opacity="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="{StaticResource SpeakerMuteIcon}" Fill="#FF453A" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Muted" Foreground="#FF453A" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Brightness HUD View -->
                <Grid x:Name="BrightnessHUDView" Visibility="Collapsed" Opacity="0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="4,0,4,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Path Data="{StaticResource SunIcon}" Fill="#FFD60A" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Brightness" Foreground="#E6E6E6" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="BrightnessPercentText" Text="65%" Foreground="#FFD60A" FontSize="13" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Brightness Progress Capsule Bar -->
                    <Grid Grid.Row="1" Margin="4,0,4,4">
                        <Border Height="4" CornerRadius="2" Background="#26FFFFFF"/>
                        <ProgressBar x:Name="BrightnessProgressBar" Height="4" Minimum="0" Maximum="100" Value="65"
                                     Foreground="#FFD60A" Background="Transparent" BorderThickness="0" ClipToBounds="True">
                            <ProgressBar.Resources>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Grid>
                                                    <Border Name="PART_Track" CornerRadius="2" Background="#26FFFFFF"/>
                                                    <Border Name="PART_Indicator" CornerRadius="2" Background="#FFD60A" HorizontalAlignment="Left"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ProgressBar.Resources>
                        </ProgressBar>
                    </Grid>
                </Grid>

                <!-- Battery HUD View -->
                <Grid x:Name="BatteryHUDView" Visibility="Collapsed" Opacity="0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="BatteryStateTitleText" Text="Charging" Foreground="#30D158" FontSize="11" FontWeight="Normal" Margin="4,0,4,4"/>

                    <DockPanel Grid.Row="1" Margin="4,0,4,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Path x:Name="BatteryIconPath" Data="{StaticResource BatteryIcon}" Fill="#30D158" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BatteryPercentText" Text="78%" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Battery Progress Indicator -->
                        <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Width="68" Height="4" CornerRadius="2" Background="#26FFFFFF" Margin="0,0,4,0">
                            <ProgressBar x:Name="BatteryProgressBar" Height="4" Minimum="0" Maximum="100" Value="78"
                                         Foreground="#30D158" Background="Transparent" BorderThickness="0" ClipToBounds="True">
                                <ProgressBar.Resources>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Grid>
                                                        <Border Name="PART_Track" CornerRadius="2" Background="#26FFFFFF"/>
                                                        <Border x:Name="PART_BatteryFill" CornerRadius="2" Background="#30D158" HorizontalAlignment="Left"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ProgressBar.Resources>
                            </ProgressBar>
                        </Border>
                    </DockPanel>
                </Grid>

                <!-- Media Controls HUD View -->
                <Grid x:Name="MediaHUDView" Visibility="Collapsed" Opacity="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Album Art / Music Icon -->
                    <Border x:Name="MediaArtworkContainer" Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#1C1C1E" Margin="0,0,12,0" VerticalAlignment="Center" ClipToBounds="True">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="MediaArtworkTransform" X="0" Y="0"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Path x:Name="MediaFallbackIconPath" Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                  Fill="#0A84FF" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="MediaAlbumArtImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Track Title & Artist -->
                    <StackPanel x:Name="MediaInfoPanel" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="MediaInfoTransform" X="0" Y="0"/>
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="MediaTrackTitleText" Text="Blinding Lights" Foreground="#E6E6E6" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="MediaArtistText" Text="The Weeknd" Foreground="#8E8E93" FontSize="11" FontWeight="Normal" TextTrimming="CharacterEllipsis" Margin="0,0,0,0"/>
                    </StackPanel>

                    <!-- Controls: Prev, Play/Pause, Next -->
                    <StackPanel x:Name="MediaControlsPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Border x:Name="MediaPrevButton" Width="28" Height="28" CornerRadius="14" Background="#1C1C1E" Cursor="Hand" Margin="0,0,8,0" VerticalAlignment="Center" MouseLeftButtonUp="MediaPrevButton_MouseLeftButtonUp">
                            <Path Data="{StaticResource PrevIcon}" Fill="#E6E6E6" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <Border x:Name="MediaActionButton" Width="32" Height="32" CornerRadius="16" Background="#FFFFFF" Cursor="Hand" Margin="0,0,8,0" VerticalAlignment="Center" MouseLeftButtonUp="MediaActionButton_MouseLeftButtonUp" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="MediaActionScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Path x:Name="MediaActionIconPath" Data="{StaticResource PauseIcon}" Fill="#000000" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <Border x:Name="MediaNextButton" Width="28" Height="28" CornerRadius="14" Background="#1C1C1E" Cursor="Hand" VerticalAlignment="Center" MouseLeftButtonUp="MediaNextButton_MouseLeftButtonUp">
                            <Path Data="{StaticResource NextIcon}" Fill="#E6E6E6" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Notification HUD View -->
                <Grid x:Name="NotificationHUDView" Visibility="Collapsed" Opacity="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#1C1C1E" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Path x:Name="NotificationIconPath" Data="{StaticResource BellIcon}" Fill="#FF9F0A" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock x:Name="NotificationAppNameText" Text="Discord" Foreground="#8E8E93" FontSize="11" FontWeight="Normal"/>
                        <TextBlock x:Name="NotificationTitleText" Text="New message received" Foreground="#E6E6E6" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NotificationMessageText" Text="" Foreground="#8E8E93" FontSize="11" FontWeight="Normal" TextTrimming="CharacterEllipsis" Visibility="Collapsed" Margin="0,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Clipboard HUD View -->
                <Grid x:Name="ClipboardHUDView" Visibility="Collapsed" Opacity="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ClipboardBadgeBorder" Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#1C3D27" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Path x:Name="ClipboardBadgeIconPath" Data="{StaticResource CheckmarkIcon}" Fill="#00E676" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock x:Name="ClipboardSummaryText" Text="Copied" Foreground="#E6E6E6" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ClipboardDetailText" Text="Hello, world!" Foreground="#8E8E93" FontSize="11" FontWeight="Normal" TextTrimming="CharacterEllipsis" Margin="0,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Smart Quick Dashboard [When Media is NOT Playing] -->
                <Grid x:Name="ExpandedView" Visibility="Collapsed" Opacity="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: Clock & Date -->
                    <DockPanel Grid.Row="0" Margin="4,0,4,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Border Width="24" Height="24" CornerRadius="12" Background="#1C1C1E" Margin="0,0,8,0">
                                <Path Data="{StaticResource SunIcon}" Fill="#00E676" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="DashboardDateText" Text="Friday, September 18" Foreground="#8E8E93" FontSize="11" FontWeight="Normal"/>
                                <TextBlock x:Name="DashboardTimeText" Text="10:45 PM" Foreground="#E6E6E6" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="#1C3D27" CornerRadius="8" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="READY" Foreground="#00E676" FontSize="10" FontWeight="Medium"/>
                        </Border>
                    </DockPanel>

                    <!-- Quick Glance Widget Cards -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Volume Card -->
                        <Border Grid.Column="0" Background="#141416" CornerRadius="10" BorderBrush="#14FFFFFF" BorderThickness="0.5" Padding="12,8">
                            <StackPanel VerticalAlignment="Center">
                                <DockPanel Margin="0,0,0,4">
                                    <Path Data="{StaticResource SpeakerHighIcon}" Fill="#0A84FF" Width="12" Height="12" Stretch="Uniform" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Volume" Foreground="#8E8E93" FontSize="11" FontWeight="Normal" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DashboardVolumeText" Text="72%" Foreground="#E6E6E6" FontSize="13" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Border Height="4" CornerRadius="2" Background="#26FFFFFF">
                                    <ProgressBar x:Name="DashboardVolumeProgress" Height="4" Minimum="0" Maximum="100" Value="72" Foreground="#0A84FF" Background="Transparent" BorderThickness="0"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Battery & Power Card -->
                        <Border Grid.Column="2" Background="#141416" CornerRadius="10" BorderBrush="#14FFFFFF" BorderThickness="0.5" Padding="12,8">
                            <StackPanel VerticalAlignment="Center">
                                <DockPanel Margin="0,0,0,4">
                                    <Path Data="{StaticResource BatteryIcon}" Fill="#30D158" Width="12" Height="12" Stretch="Uniform" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="DashboardBatteryStateText" Text="Battery" Foreground="#8E8E93" FontSize="11" FontWeight="Normal" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DashboardBatteryPercentText" Text="78%" Foreground="#E6E6E6" FontSize="13" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Border Height="4" CornerRadius="2" Background="#26FFFFFF">
                                    <ProgressBar x:Name="DashboardBatteryProgress" Height="4" Minimum="0" Maximum="100" Value="78" Foreground="#30D158" Background="Transparent" BorderThickness="0"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Footer / Quick Launch Buttons -->
                    <DockPanel Grid.Row="2" Margin="4,0,4,0">
                        <TextBlock Text="Dynamic Island for Windows" Foreground="#555555" FontSize="10" FontWeight="Medium" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <Border Background="#1C1C1E" CornerRadius="10" Padding="8,4" HorizontalAlignment="Right" DockPanel.Dock="Right" Cursor="Hand" MouseLeftButtonUp="SettingsButton_MouseLeftButtonUp">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource SettingsIcon}" Fill="#8E8E93" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" Foreground="#8E8E93" FontSize="10" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Grid>

                <!-- Rich Media Expanded "More Info" Card View -->
                <Grid x:Name="MediaExpandedView" Visibility="Collapsed" Opacity="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Header -->
                    <DockPanel Grid.Row="0" Margin="4,0,4,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Border Width="20" Height="20" CornerRadius="10" Background="#1C1C1E" Margin="0,0,8,0">
                                <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                      Fill="#0A84FF" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Now Playing" Foreground="#8E8E93" FontSize="11" FontWeight="Normal" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Live Visualizer in Header -->
                        <StackPanel x:Name="ExpandedVisualizer" Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="0,0,4,0">
                            <Border x:Name="ExpEQ1" Width="2.5" Height="10" CornerRadius="1.2" Background="#00E676" Margin="1,0"/>
                            <Border x:Name="ExpEQ2" Width="2.5" Height="6" CornerRadius="1.2" Background="#00E676" Margin="1,0"/>
                            <Border x:Name="ExpEQ3" Width="2.5" Height="12" CornerRadius="1.2" Background="#00E676" Margin="1,0"/>
                            <Border x:Name="ExpEQ4" Width="2.5" Height="8" CornerRadius="1.2" Background="#00E676" Margin="1,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Track Info + Large Artwork Body -->
                    <Border Grid.Row="1" Background="#141416" CornerRadius="10" BorderBrush="#14FFFFFF" BorderThickness="0.5" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="#1C1C1E" Margin="0,0,12,0" ClipToBounds="True">
                                <Grid>
                                    <Path x:Name="MediaExpandedFallbackIconPath" Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                          Fill="#0A84FF" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="MediaExpandedAlbumArtImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="MediaExpandedTrackTitleText" Text="Blinding Lights" Foreground="#E6E6E6" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MediaExpandedArtistText" Text="The Weeknd" Foreground="#8E8E93" FontSize="11" FontWeight="Normal" TextTrimming="CharacterEllipsis" Margin="0,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Interactive Timeline Seek Bar -->
                    <Grid Grid.Row="2" Margin="4,0,4,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Progress Bar (Clickable) -->
                        <Grid Grid.Row="0" Cursor="Hand" MouseLeftButtonUp="TimelineProgress_MouseLeftButtonUp">
                            <Border Height="4" CornerRadius="2" Background="#26FFFFFF"/>
                            <ProgressBar x:Name="MediaTimelineProgressBar" Height="4" Minimum="0" Maximum="100" Value="35"
                                         Foreground="#E6E6E6" Background="Transparent" BorderThickness="0" ClipToBounds="True">
                                <ProgressBar.Resources>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Grid>
                                                        <Border Name="PART_Track" CornerRadius="2" Background="#26FFFFFF"/>
                                                        <Border Name="PART_Indicator" CornerRadius="2" Background="#E6E6E6" HorizontalAlignment="Left"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ProgressBar.Resources>
                            </ProgressBar>
                        </Grid>

                        <!-- Timestamps (Position & Duration) -->
                        <DockPanel Grid.Row="1" Margin="0,4,0,0">
                            <TextBlock x:Name="MediaCurrentPosText" Text="01:24" Foreground="#555555" FontSize="10" FontWeight="Medium" DockPanel.Dock="Left"/>
                            <TextBlock x:Name="MediaTotalDurText" Text="03:45" Foreground="#555555" FontSize="10" FontWeight="Medium" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Grid>

                    <!-- Playback Controls (10s Back, Prev, Large Play/Pause, Next, 10s Forward) -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4">
                        <!-- Replay 10s -->
                        <Border x:Name="MediaReplay10Button" Width="28" Height="28" CornerRadius="14" Background="#1C1C1E" Cursor="Hand" Margin="0,0,12,0" VerticalAlignment="Center" MouseLeftButtonUp="MediaReplay10Button_MouseLeftButtonUp">
                            <Path Data="{StaticResource Replay10Icon}" Fill="#E6E6E6" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Previous Track -->
                        <Border x:Name="MediaExpandedPrevButton" Width="32" Height="32" CornerRadius="16" Background="#1C1C1E" Cursor="Hand" Margin="0,0,12,0" VerticalAlignment="Center" MouseLeftButtonUp="MediaPrevButton_MouseLeftButtonUp">
                            <Path Data="{StaticResource PrevIcon}" Fill="#E6E6E6" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Large Play / Pause Action Button -->
                        <Border x:Name="MediaExpandedActionButton" Width="40" Height="40" CornerRadius="20" Background="#FFFFFF" Cursor="Hand" Margin="0,0,12,0" VerticalAlignment="Center" MouseLeftButtonUp="MediaExpandedActionButton_MouseLeftButtonUp" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="MediaExpandedActionScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Path x:Name="MediaExpandedActionIconPath" Data="{StaticResource PauseIcon}" Fill="#000000" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Next Track -->
                        <Border x:Name="MediaExpandedNextButton" Width="32" Height="32" CornerRadius="16" Background="#1C1C1E" Cursor="Hand" Margin="0,0,12,0" VerticalAlignment="Center" MouseLeftButtonUp="MediaNextButton_MouseLeftButtonUp">
                            <Path Data="{StaticResource NextIcon}" Fill="#E6E6E6" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Forward 10s -->
                        <Border x:Name="MediaForward10Button" Width="28" Height="28" CornerRadius="14" Background="#1C1C1E" Cursor="Hand" VerticalAlignment="Center" MouseLeftButtonUp="MediaForward10Button_MouseLeftButtonUp">
                            <Path Data="{StaticResource Forward10Icon}" Fill="#E6E6E6" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
